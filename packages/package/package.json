{
  "name": "@armit/package",
  "version": "0.3.1",
  "homepage": "https://github.com/armitjs/armit",
  "repository": {
    "type": "git",
    "url": "https://github.com/armitjs/armit",
    "directory": "packages/package"
  },
  "license": "MIT",
  "author": {
    "name": "Yingchun Tian",
    "url": "https://github.com/tianyingchun"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p ./tsconfig.build.json",
    "?build-release": "When https://github.com/atlassian/changesets/issues/432 has a solution we can remove this trick",
    "build-release": "yarn build && rimraf ./_release && yarn pack && mkdir ./_release && tar zxvf ./package.tgz --directory ./_release && rm ./package.tgz",
    "dev": "tsc -p ./tsconfig.build.json --watch",
    "clean": "rimraf --no-glob ./dist ./_release ./coverage ./tsconfig.tsbuildinfo",
    "lint": "eslint . --cache --cache-location ../../.cache/eslint/package.eslintcache",
    "fix-all-files": "eslint . --fix",
    "test": "run-s test-unit",
    "test-unit": "vitest run --passWithNoTests",
    "test-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "tsc --jsx react-jsx --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@armit/file-utility": "workspace:^",
    "@armit/logger-node": "workspace:^",
    "@hyperse/install-local": "^1.0.3",
    "as-table": "^1.0.55",
    "boxen": "8.0.1",
    "cosmiconfig": "^10.0.0",
    "execa": "^10.0.1",
    "glob": "^13.0.6",
    "has-yarn": "^4.0.0",
    "import-meta-resolve": "^4.2.0",
    "is-installed-globally": "^1.0.0",
    "is-npm": "^6.1.0",
    "is-yarn-global": "^0.4.1",
    "npm-check-updates": "^23.0.2",
    "ora": "^9.4.1",
    "package-json": "^10.0.1",
    "package-up": "^5.0.0",
    "picocolors": "^1.1.1",
    "pkg-dir": "^9.0.0",
    "semver": "^7.8.5",
    "type-fest": "^5.8.0",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@hyperse/eslint-config-hyperse": "^1.7.4",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "10.8.1",
    "npm-run-all": "4.1.5",
    "react": "^19.2.8",
    "rimraf": "6.1.3",
    "semver-regex": "4.0.5",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "_release/package"
  }
}
