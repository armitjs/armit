{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {}
  },
  "include": ["./src/**/*.ts"],
  "exclude": [
    "**/*.stories.tsx",
    "**/*.stories.mdx",
    ".storybook/**",
    "dist",
    "**/__tests__/**"
  ]
}
